<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Crystal — She's Alive</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: #000;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .space-bg {
    position: fixed; inset: 0;
    background: radial-gradient(ellipse at 30% 20%, #0a1628 0%, #000 60%),
                radial-gradient(ellipse at 70% 80%, #0d1b2e 0%, #000 50%);
    z-index: 0;
  }
  .stars { position: fixed; inset: 0; z-index: 0; }
  .star { position: absolute; background: #fff; border-radius: 50%; animation: twinkle 3s ease-in-out infinite; }
  @keyframes twinkle { 0%,100% { opacity: .2; } 50% { opacity: .9; } }

  .demo-area {
    flex: 1; position: relative; z-index: 1;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 12px; padding: 20px;
  }
  h1 { font-size: 22px; font-weight: 600; color: #a5f3fc; letter-spacing: 1px; }
  .subtitle { color: #64748b; font-size: 14px; }

  .controls {
    display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;
    z-index: 2; margin-top: 8px;
  }
  .controls button {
    background: rgba(103,232,249,.1); border: 1px solid rgba(103,232,249,.4);
    color: #a5f3fc; padding: 10px 18px; border-radius: 12px; cursor: pointer;
    font-size: 14px; transition: all .2s;
  }
  .controls button:hover { background: rgba(103,232,249,.25); transform: translateY(-1px); }
  .controls button:active { transform: translateY(1px); }

  /* ============ TOOLBAR ============ */
  .toolbar-wrap { position: relative; z-index: 1; padding: 0 16px 24px; }
  .toolbar {
    position: relative; height: 76px; border-radius: 20px;
    background: rgba(5,8,15,.92);
    border: 1px solid rgba(103,232,249,.15);
    box-shadow: 0 0 40px rgba(103,232,249,.08), inset 0 1px 0 rgba(255,255,255,.05);
    overflow: visible;
  }
  .neon-strip {
    position: absolute; top: 0; left: 24px; right: 24px; height: 3px;
    background: linear-gradient(90deg, #22d3ee, #67e8f9, #38bdf8, #22d3ee);
    background-size: 200% 100%;
    border-radius: 3px; filter: blur(1px);
    animation: neonFlow 4s linear infinite;
    box-shadow: 0 0 12px #22d3ee, 0 0 24px rgba(34,211,238,.5);
  }
  @keyframes neonFlow { 0% { background-position: 0% 0; } 100% { background-position: 200% 0; } }
  .toolbar-icons {
    display: flex; align-items: center; justify-content: center;
    gap: 28px; height: 100%; padding-top: 8px; color: #475569; font-size: 22px;
  }

  /* ============ CRYSTAL ROBOT ============ */
  #crystal-stage {
    position: absolute; bottom: 100%; left: 0; right: 0; height: 110px;
    pointer-events: none; overflow: visible;
  }
  #crystal {
    position: absolute; bottom: 6px; left: 50%;
    width: 88px; height: 112px;
    transform: translateX(-50%);
    pointer-events: auto; cursor: pointer;
    transition: left 1.4s cubic-bezier(.4,.1,.4,1);
    filter: drop-shadow(0 0 16px rgba(103,232,249,.5));
  }
  #crystal .bot { width: 100%; height: 100%; transform-origin: 50% 90%; }

  /* walk bob + dance sway */
  #crystal.walking .bot { animation: danceWalk 1s ease-in-out infinite; }
  @keyframes danceWalk {
    0%,100% { transform: rotate(-6deg) translateY(0) rotateY(-12deg); }
    25% { transform: rotate(4deg) translateY(-5px) rotateY(0deg); }
    50% { transform: rotate(6deg) translateY(0) rotateY(12deg); }
    75% { transform: rotate(-4deg) translateY(-5px) rotateY(0deg); }
  }
  /* jump */
  #crystal.jumping .bot { animation: jumpAnim 1.1s cubic-bezier(.4,.7,.4,1); }
  @keyframes jumpAnim {
    0% { transform: translateY(0) scale(1,1); }
    30% { transform: translateY(-18px) scale(.97,1.04); }
    55% { transform: translateY(0) scale(1.04,.94); }
    75% { transform: translateY(-4px) scale(.99,1.01); }
    100% { transform: translateY(0) scale(1,1); }
  }
  /* trip and fall */
  #crystal.tripping .bot { animation: tripAnim 2.2s ease-in-out; }
  @keyframes tripAnim {
    0% { transform: rotate(0) translateY(0); }
    25% { transform: rotate(-50deg) translateY(4px); }
    55% { transform: rotate(-50deg) translateY(4px); }
    80% { transform: rotate(4deg) translateY(-3px); }
    100% { transform: rotate(0) translateY(0); }
  }
  /* spin */
  #crystal.spinning .bot { animation: spinAnim 1.2s cubic-bezier(.4,.7,.4,1); }
  @keyframes spinAnim { 0% { transform: rotateY(0); } 100% { transform: rotateY(360deg); } }
  /* wave arm */
  #crystal .arm-r { transform-origin: 68px 66px; transform-box: fill-box; }
  #crystal.waving .arm-r { animation: waveArm 2s ease-in-out; }
  @keyframes waveArm {
    0%,100% { transform: rotate(0); }
    20%,60% { transform: rotate(-24deg); }
    40%,80% { transform: rotate(8deg); }
  }
  /* peek-a-boo */
  #crystal.peeking .bot { animation: peekABoo 2.4s ease-in-out; }
  @keyframes peekABoo {
    0% { transform: translateY(0); }
    30% { transform: translateY(70px); }
    55% { transform: translateY(70px); }
    75% { transform: translateY(-8px); }
    100% { transform: translateY(0); }
  }
  /* sleepy breathing */
  #crystal.sleeping .bot { animation: sleepBreathe 4s ease-in-out infinite; }
  @keyframes sleepBreathe {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.04, .96); }
  }
  .zzz { position: absolute; top: -8px; right: 8px; color: #67e8f9; font-size: 16px;
    opacity: 0; pointer-events: none; font-weight: bold; }
  #crystal.sleeping .zzz { animation: zFloat 4s ease-in-out infinite; }
  @keyframes zFloat {
    0% { opacity: 0; transform: translateY(0) scale(.8); }
    30% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-34px) scale(1.3); }
  }
  /* happy wiggle */
  #crystal.wiggling .bot { animation: happyWiggle .9s ease-in-out; }
  @keyframes happyWiggle {
    0%,100% { transform: rotate(0) translateX(0); }
    20% { transform: rotate(-8deg) translateX(-6px); }
    40% { transform: rotate(8deg) translateX(6px); }
    60% { transform: rotate(-8deg) translateX(-6px); }
    80% { transform: rotate(8deg) translateX(6px); }
  }
  /* curious head tilt */
  #crystal.tilting .bot { animation: headTilt 1.8s ease-in-out; }
  @keyframes headTilt {
    0%,100% { transform: rotate(0); }
    35% { transform: rotate(-14deg) translateY(-4px); }
    65% { transform: rotate(-14deg) translateY(-4px); }
  }
  /* blush cheeks */
  .blush { opacity: 0; transition: opacity .5s; }
  #crystal.blushing .blush { opacity: 1; }
  /* ear wiggle */
  #crystal.earwiggle .ear-l { animation: earWiggleL 1s ease-in-out; transform-origin: 20px 16px; transform-box: fill-box; }
  #crystal.earwiggle .ear-r { animation: earWiggleR 1s ease-in-out; transform-origin: 68px 16px; transform-box: fill-box; }
  @keyframes earWiggleL { 0%,100% { transform: rotate(0); } 25%,75% { transform: rotate(-18deg); } 50% { transform: rotate(10deg); } }
  @keyframes earWiggleR { 0%,100% { transform: rotate(0); } 25%,75% { transform: rotate(18deg); } 50% { transform: rotate(-10deg); } }
  /* shy turn-away */
  #crystal.shying .bot { animation: shyAnim 2.4s ease-in-out; }
  @keyframes shyAnim {
    0% { transform: rotateY(0); }
    30% { transform: rotateY(55deg); }
    60% { transform: rotateY(55deg); }
    80% { transform: rotateY(-12deg); }
    100% { transform: rotateY(0); }
  }
  /* thoughtful chin tap */
  #crystal.thinking .bot { animation: thinkAnim 2.4s ease-in-out; }
  @keyframes thinkAnim {
    0%,100% { transform: rotate(0) translateY(0); }
    40% { transform: rotate(6deg) translateY(-6px); }
    60% { transform: rotate(6deg) translateY(-6px); }
  }
  #crystal.thinking .arm-r { animation: chinTap 2.4s ease-in-out; }
  @keyframes chinTap {
    0%,100% { transform: rotate(0) translateY(0); }
    40%,60% { transform: rotate(-30deg) translateY(-10px); }
  }
  /* greeting bow */
  #crystal.bowing .bot { animation: bowAnim 1.6s ease-in-out; }
  @keyframes bowAnim {
    0%,100% { transform: rotateX(0); }
    40% { transform: rotateX(28deg) translateY(8px); }
    60% { transform: rotateX(28deg) translateY(8px); }
  }
  /* dizzy stars */
  .dizzy-stars { position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
    color: #fbbf24; font-size: 14px; opacity: 0; pointer-events: none; white-space: nowrap; }
  #crystal.dizzying .dizzy-stars { animation: starSpin 1.8s linear; }
  @keyframes starSpin {
    0% { opacity: 1; transform: translateX(-50%) rotate(0deg); }
    100% { opacity: 0; transform: translateX(-50%) rotate(360deg); }
  }
  /* excited bounce */
  #crystal.excited .bot { animation: excitedBounce 1.2s ease-in-out; }
  @keyframes excitedBounce {
    0%,100% { transform: translateY(0) scale(1); }
    20%,60% { transform: translateY(-14px) scale(.96,1.05); }
    40%,80% { transform: translateY(0) scale(1.05,.93); }
  }
  /* joyful dance — from the snow video: sway, bounce, arms out, happy squint */
  #crystal.dancing .bot { animation: happyDance 2.4s ease-in-out; }
  @keyframes happyDance {
    0%,100% { transform: rotate(0) translateX(0) translateY(0); }
    10% { transform: rotate(-9deg) translateX(-10px) translateY(-8px); }
    20% { transform: rotate(9deg) translateX(10px) translateY(0); }
    30% { transform: rotate(-9deg) translateX(-10px) translateY(-12px); }
    40% { transform: rotate(9deg) translateX(10px) translateY(0); }
    50% { transform: rotate(-9deg) translateX(-10px) translateY(-8px) scale(1.03); }
    60% { transform: rotate(9deg) translateX(10px) translateY(-12px); }
    70% { transform: rotate(-9deg) translateX(-10px) translateY(0); }
    80% { transform: rotate(9deg) translateX(10px) translateY(-8px); }
    90% { transform: rotate(-4deg) translateX(-5px) translateY(-4px); }
  }
  #crystal.dancing .eyelid { animation: happySquint 2.4s ease-in-out; }
  @keyframes happySquint {
    0%,100% { transform: scaleY(0); }
    15%,85% { transform: scaleY(.75); }
  }
  /* yawn and stretch */
  #crystal.yawning .bot { animation: yawnStretch 3s ease-in-out; }
  @keyframes yawnStretch {
    0%,100% { transform: scale(1); }
    30% { transform: scale(1.12, 1.08); }
    50% { transform: scale(1.12, 1.08); }
    70% { transform: scale(.96, 1); }
  }
  /* celebrate triple jump */
  #crystal.celebrating .bot { animation: celebJump 2.2s cubic-bezier(.4,.7,.4,1); }
  @keyframes celebJump {
    0%,100% { transform: translateY(0); }
    15%,45%,75% { transform: translateY(-16px); }
    30%,60%,90% { transform: translateY(0) scale(1.04,.94); }
  }
  /* idle bob */
  #crystal .bot { animation: idleBob 4s ease-in-out infinite; }
  #crystal.walking .bot, #crystal.jumping .bot, #crystal.tripping .bot,
  #crystal.spinning .bot, #crystal.celebrating .bot, #crystal.peeking .bot,
  #crystal.sleeping .bot, #crystal.wiggling .bot, #crystal.tilting .bot,
  #crystal.shying .bot, #crystal.thinking .bot, #crystal.bowing .bot,
  #crystal.excited .bot, #crystal.yawning .bot, #crystal.dancing .bot {
    animation-name: danceWalk, jumpAnim, tripAnim, spinAnim, celebJump, peekABoo,
      sleepBreathe, happyWiggle, headTilt, shyAnim, thinkAnim, bowAnim,
      excitedBounce, yawnStretch, happyDance;
  }
  @keyframes idleBob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-2px); } }

  .face-happy, .face-curious, .face-surprised, .face-sleepy, .face-dizzy, .face-joy { display: none; }
  #crystal[data-mood="happy"] .face-happy { display: block; }
  #crystal[data-mood="happy"] .face-default { display: none; }
  #crystal[data-mood="curious"] .face-curious { display: block; }
  #crystal[data-mood="curious"] .face-default { display: none; }
  #crystal[data-mood="surprised"] .face-surprised { display: block; }
  #crystal[data-mood="surprised"] .face-default { display: none; }
  #crystal[data-mood="sleepy"] .face-sleepy { display: block; }
  #crystal[data-mood="sleepy"] .face-default { display: none; }
  #crystal[data-mood="dizzy"] .face-dizzy { display: block; }
  #crystal[data-mood="dizzy"] .face-default { display: none; }
  #crystal[data-mood="joy"] .face-joy { display: block; }
  #crystal[data-mood="joy"] .face-default { display: none; }

  .blink-eyes { animation: blinkAnim 5s infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes blinkAnim { 0%,92%,100% { transform: scaleY(1); } 95% { transform: scaleY(.08); } }

  /* character variants */
  .char-svg { display: none; width: 100%; height: 100%; }
  .char-fluffling { display: block; }
  /* fluffling eyelids for blinking (positioned over her big eyes) */
  .eyelid { position: absolute; border-radius: 50%;
    background: #f3c1d4; transform: scaleY(0); transform-origin: center; }
  .eyelid { display: block; }
  .eyelid-l { left: 30%; top: 30%; width: 17%; height: 13%; }
  .eyelid-r { left: 53%; top: 30%; width: 17%; height: 13%; }
  #crystal.blinking .eyelid { animation: lidBlink .35s ease-in-out; }
  @keyframes lidBlink { 0%,100% { transform: scaleY(0); } 50% { transform: scaleY(1); } }

  /* neon rainbow body color cycle */
  .body-fill { animation: bodyTint 14s ease-in-out infinite; }
  @keyframes bodyTint {
    0%,100% { fill: #ffd6e0; }
    12.5% { fill: #ffe3c2; }
    25% { fill: #fff3b8; }
    37.5% { fill: #c8f7c5; }
    50% { fill: #b8f1f5; }
    62.5% { fill: #c2d9ff; }
    75% { fill: #d9c6ff; }
    87.5% { fill: #f5c2f0; }
  }
  .belly-fill { animation: bellyTint 14s ease-in-out infinite; }
  @keyframes bellyTint {
    0%,100% { fill: #f0b8c8; }
    12.5% { fill: #f5c99a; }
    25% { fill: #f5e58e; }
    37.5% { fill: #a8e6a3; }
    50% { fill: #93e2e8; }
    62.5% { fill: #9db8f5; }
    75% { fill: #bfa3f5; }
    87.5% { fill: #ee9fe8; }
  }

  .status {
    z-index: 2; color: #67e8f9; font-size: 13px; min-height: 20px;
    font-style: italic;
  }
  .hint { z-index: 2; color: #475569; font-size: 12px; margin-top: 4px; }
</style>
</head>
<body>
<div class="space-bg"></div>
<div class="stars" id="stars"></div>

<div class="demo-area">
  <h1>✦ CRYSTAL ✦</h1>
  <div class="subtitle">Pick her character — all 18 motions work on each</div>
  <div class="char-desc" id="charDesc" style="z-index:2;color:#94a3b8;font-size:13px;max-width:520px;text-align:center;min-height:36px"></div>
  <div class="status" id="status">Crystal is exploring...</div>

  <div class="toolbar-wrap" style="width:min(560px,92vw)">
    <div class="toolbar">
      <div class="neon-strip"></div>
      <div id="crystal-stage">
        <div id="crystal" data-mood="happy" title="Hi, I'm Crystal!">
          <div class="zzz">z z z</div>
          <div class="dizzy-stars">✦ ✧ ✦</div>
          <img class="bot char-svg char-fluffling" src="crystal-pink-fluffling.png" alt="Crystal the pink fluffling"
               style="object-fit:contain;filter:drop-shadow(0 0 12px rgba(244,114,182,.35))" />
          <div class="eyelid eyelid-l"></div>
          <div class="eyelid eyelid-r"></div>
        </div>
      </div>
      <div class="toolbar-icons"><span>◉</span><span>◎</span><span>◈</span><span>⬢</span><span>⬣</span></div>
    </div>
  </div>

  <div class="controls">
    <button onclick="doWalk()">🚶 Walk</button>
    <button onclick="doJump()">⤴️ Jump</button>
    <button onclick="doWave()">👋 Wave</button>
    <button onclick="doTrip()">🤪 Trip!</button>
    <button onclick="doSpin()">🌀 Spin</button>
    <button onclick="doCelebrate()">🎉 Celebrate</button>
    <button onclick="doPeek()">👀 Peek-a-boo</button>
    <button onclick="doSleep()">😴 Sleep</button>
    <button onclick="doWiggle()">💃 Wiggle</button>
    <button onclick="doTilt()">🤔 Curious</button>
    <button onclick="doBlush()">☺️ Blush</button>
    <button onclick="doEarWiggle()">🐻 Ears</button>
    <button onclick="doShy()">🙈 Shy</button>
    <button onclick="doThink()">💭 Think</button>
    <button onclick="doBow()">🙇 Bow</button>
    <button onclick="doDizzy()">💫 Dizzy</button>
    <button onclick="doExcited()">⚡ Excited</button>
    <button onclick="doYawn()">🥱 Yawn</button>
    <button onclick="doDance()">💃 Dance!</button>
  </div>
  <div class="hint">She also wanders on her own — click her anytime!</div>
</div>

<script>
const crystal = document.getElementById('crystal');
const stage = document.getElementById('crystal-stage');
const status = document.getElementById('status');
const moods = ['happy','curious','surprised','sleepy','joy'];



function setStatus(t){ status.textContent = t; }
function setMood(m){ crystal.dataset.mood = m; }
function clearAnims(){
  crystal.classList.remove('walking','jumping','waving','tripping','spinning','celebrating',
    'peeking','sleeping','wiggling','tilting','blushing','earwiggle','shying','thinking',
    'bowing','dizzying','excited','yawning');
}
function busy(ms){
  return new Promise(r => setTimeout(r, ms));
}
async function doWalk(){
  clearAnims();
  const maxX = stage.offsetWidth - 70;
  const x = 20 + Math.random() * (maxX - 40);
  crystal.style.left = x + 'px';
  crystal.classList.add('walking');
  setMood('happy'); setStatus('Crystal is wandering...');
  await busy(1300);
  crystal.classList.remove('walking');
}
async function doJump(){
  clearAnims(); crystal.classList.add('jumping');
  setMood('joy'); setStatus('Boing!');
  await busy(750); crystal.classList.remove('jumping'); setMood('happy');
}
async function doWave(){
  clearAnims(); crystal.classList.add('waving');
  setMood('happy'); setStatus('Crystal waves hello! 👋');
  await busy(1500); crystal.classList.remove('waving');
}
async function doTrip(){
  clearAnims(); crystal.classList.add('tripping');
  setMood('dizzy'); setStatus('Whoa—! *thud* ...she\'s okay!');
  await busy(1700); crystal.classList.remove('tripping');
  setMood('happy'); setStatus('Shook it off. All good!');
}
async function doSpin(){
  clearAnims(); crystal.classList.add('spinning');
  setMood('joy'); setStatus('Wheee!');
  await busy(850); crystal.classList.remove('spinning'); setMood('happy');
}
async function doCelebrate(){
  clearAnims(); crystal.classList.add('celebrating');
  setMood('joy'); setStatus('🎉 Task complete! Crystal celebrates!');
  await busy(2300); crystal.classList.remove('celebrating'); setMood('happy');
}
async function doPeek(){
  clearAnims(); crystal.classList.add('peeking');
  setMood('surprised'); setStatus('Peek-a-boo! 👀');
  await busy(2500); crystal.classList.remove('peeking'); setMood('happy');
}
async function doSleep(){
  clearAnims(); crystal.classList.add('sleeping');
  setMood('sleepy'); setStatus('Shhh... Crystal is napping 😴');
  await busy(8000); crystal.classList.remove('sleeping'); setMood('happy'); setStatus('Crystal is exploring...');
}
async function doWiggle(){
  clearAnims(); crystal.classList.add('wiggling');
  setMood('joy'); setStatus('Happy wiggle dance! 💃');
  await busy(1000); crystal.classList.remove('wiggling'); setMood('happy');
}
async function doTilt(){
  clearAnims(); crystal.classList.add('tilting');
  setMood('curious'); setStatus('Hmm? What\'s that? 🤔');
  await busy(1900); crystal.classList.remove('tilting'); setMood('happy');
}
async function doBlush(){
  clearAnims(); crystal.classList.add('blushing');
  setMood('joy'); setStatus('Aw, you\'re making her blush! ☺️');
  await busy(2500); crystal.classList.remove('blushing');
}
async function doEarWiggle(){
  clearAnims(); crystal.classList.add('earwiggle');
  setMood('happy'); setStatus('Wiggle wiggle! 🐻');
  await busy(1100); crystal.classList.remove('earwiggle');
}
async function doShy(){
  clearAnims(); crystal.classList.add('shying');
  setMood('curious'); setStatus('Oh... um... hi 🙈');
  await busy(2500); crystal.classList.remove('shying'); setMood('happy');
}
async function doThink(){
  clearAnims(); crystal.classList.add('thinking');
  setMood('curious'); setStatus('Let me think about that... 💭');
  await busy(2500); crystal.classList.remove('thinking'); setMood('happy');
}
async function doBow(){
  clearAnims(); crystal.classList.add('bowing');
  setMood('happy'); setStatus('Welcome aboard, pilot! 🙇');
  await busy(1700); crystal.classList.remove('bowing');
}
async function doDizzy(){
  clearAnims(); crystal.classList.add('dizzying');
  setMood('dizzy'); setStatus('Whoa... too many spins! 💫');
  await busy(1900); crystal.classList.remove('dizzying'); setMood('happy');
}
async function doExcited(){
  clearAnims(); crystal.classList.add('excited');
  setMood('joy'); setStatus('Sync complete! She\'s thrilled! ⚡');
  await busy(1300); crystal.classList.remove('excited'); setMood('happy');
}
async function doDance(){
  clearAnims(); crystal.classList.add('dancing');
  setMood('joy'); setStatus('She\'s dancing with joy! 💃');
  await busy(2500); crystal.classList.remove('dancing'); setMood('happy');
}
async function doYawn(){
  clearAnims(); crystal.classList.add('yawning');
  setMood('sleepy'); setStatus('Big streeetch... 🥱');
  await busy(3100); crystal.classList.remove('yawning'); setMood('happy');
}
crystal.addEventListener('click', () => { doSpin(); });
crystal.addEventListener('mouseenter', () => {
  if (!crystal.classList.length || crystal.className === '') return;
  setMood('curious'); setStatus('Crystal notices you... 👀');
  setTimeout(() => { if(!isBusy()) setMood('happy'); }, 1800);
});
function isBusy(){
  return ['walking','jumping','waving','tripping','spinning','celebrating',
    'peeking','sleeping','wiggling','tilting','blushing','earwiggle','shying',
    'thinking','bowing','dizzying','excited','yawning','dancing']
    .some(c => crystal.classList.contains(c));
}
// fluffling blink loop (from the video — she blinks softly)
setInterval(() => {
  if (isBusy()) return;
  crystal.classList.add('blinking');
  setTimeout(() => crystal.classList.remove('blinking'), 400);
}, 4200);
// autonomous personality
(function wander(){
  setTimeout(async () => {
    if (isBusy()) { wander(); return; }
    const roll = Math.random();
    if (roll < .4) await doWalk();
    else if (roll < .55) await doJump();
    else if (roll < .7) { setMood(moods[Math.floor(Math.random()*moods.length)]); setStatus('Crystal is feeling ' + crystal.dataset.mood + '...'); await busy(2200); setMood('happy'); }
    else if (roll < .8) await doWave();
    else if (roll < .86) await doTrip();
    else if (roll < .90) { await doDance(); }
    else if (roll < .94 && true) {
      // video-inspired: curious look-around (head tilts side to side)
      clearAnims(); crystal.classList.add('tilting');
      setMood('curious'); setStatus('She looks around curiously...');
      await busy(1900); crystal.classList.remove('tilting'); setMood('happy');
    }
    else { setStatus('Crystal is dreaming...'); setMood('sleepy'); await busy(2500); setMood('happy'); setStatus('Crystal is exploring...'); }
    wander();
  }, 5000 + Math.random() * 6000);
})();
// stars
(function(){
  const s = document.getElementById('stars');
  for (let i = 0; i < 70; i++) {
    const d = document.createElement('div');
    d.className = 'star';
    const sz = Math.random() * 2 + 1;
    d.style.cssText = `left:${Math.random()*100}%;top:${Math.random()*70}%;width:${sz}px;height:${sz}px;animation-delay:${Math.random()*3}s`;
    s.appendChild(d);
  }
})();
</script>
</body>
</html>
